// WorkLink — Datenmodell (PostgreSQL, self-hosted auf dem VPS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Recruiting-Pipeline — Status wie im bestehenden Dashboard.
enum ApplicationStatus {
  NEU
  ZAV_ANFRAGE
  VORABZUSTIMMUNG
  VERTRAG_EZB
  ONBOARDED
  SCHEDULED_TRAINING
  EINGESTELLT
  REJECTED
}

/// Bewerbung eines Kandidaten (aus dem mehrsprachigen Formular).
model Application {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(NEU)
  lang   String?

  // Vorauswahl
  employment   String?
  truckLicense String?
  code95       String? // nur relevant, wenn truckLicense = "Ja"
  field        String?

  // Identität
  firstName      String
  lastName       String
  dob            String?
  placeOfBirth   String?
  nationality    String?
  countryOfBirth String?

  // Adresse
  street      String?
  postalCode  String?
  city        String?
  livingSince String?

  // Kontakt & Größen
  email      String
  phone      String
  tshirtSize String?
  shoeSize   String?

  // Einwilligung
  dsgvoConsent   Boolean   @default(false)
  dsgvoConsentAt DateTime?

  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Hochgeladenes Dokument (auf dem VPS gespeichert, nur Metadaten in der DB).
model Document {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  slot          String // idFront | idBack | selfie | licenseFront | licenseBack | certificate
  filename      String // ursprünglicher Dateiname
  storedName    String // Name auf der Platte
  mime          String
  size          Int
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

/// Personalanfrage eines Unternehmens (mehrstufiger Wizard).
model CompanyInquiry {
  id      String  @id @default(cuid())
  company String
  contact String
  email   String
  phone   String?
  city    String? // Einsatzort (PLZ/Ort)

  // Bedarf
  jobDescription String? // kurze Beschreibung der Stelle(n)
  industry       String? // Altbestand (früher Branchen-Auswahl)
  headcount      String? // z. B. "2–5"
  startDate      String? // z. B. "So bald wie möglich"

  // Anforderungen an die Mitarbeiter
  driverLicense String? // Pflicht Pkw / Pflicht Lkw / Wünschenswert / Nicht erforderlich
  germanLevel   String? // Keine / A1–A2 / B1–B2 / C1+
  englishLevel  String? // Keine / A1–A2 / B1–B2 / C1+

  // Bezahlung & Konditionen
  payType      String? // Stundenlohn / Festgehalt
  payAmount    String? // z. B. "16 €/Stunde" oder "2.800 €/Monat brutto"
  payExtras    String? // z. B. "Spesen, Bonus / Prämien" (kommagetrennt)
  vacationDays String? // z. B. "26–30 Tage"

  // Unterkunft — zentral für Westbalkan-Vermittlung
  accommodation  String? // Ja / Nein
  roomType       String? // Einzelzimmer / 2-Bett-Zimmer / Beides
  rentWarm       String? // Warmmiete €/Monat (optional, Freitext)
  commuteMinutes String? // Weg zur Arbeit, z. B. "15–30 Min"

  message   String?
  handled   Boolean        @default(false)
  photos    InquiryPhoto[]
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

/// Foto einer angebotenen Unterkunft (Datei auf dem VPS, Metadaten hier).
model InquiryPhoto {
  id         String         @id @default(cuid())
  inquiry    CompanyInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId  String
  filename   String
  storedName String
  mime       String
  size       Int
  createdAt  DateTime       @default(now())

  @@index([inquiryId])
}
