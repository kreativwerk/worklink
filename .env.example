# --- WorkLink · Beispiel-Konfiguration ---
# Auf dem VPS nach .env kopieren und Werte anpassen:  cp .env.example .env

# Domain für automatisches HTTPS (Caddy holt das Zertifikat via Let's Encrypt).
# Der DNS-A-Record dieser Domain muss auf die IP des VPS zeigen.
DOMAIN=worklink-recruiting.com

# PostgreSQL (bleibt intern im Docker-Netz)
POSTGRES_USER=worklink
POSTGRES_PASSWORD=bitte-ein-starkes-passwort
POSTGRES_DB=worklink

# Admin-Login (Basic Auth für /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-ein-starkes-passwort

# --- Nur für lokale Entwicklung (ohne Docker) relevant ---
# DATABASE_URL="postgresql://worklink:worklink@localhost:5432/worklink?schema=public"
# UPLOAD_DIR="./.data/uploads"
